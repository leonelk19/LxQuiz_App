type Query {
  userProfile(uid: String!): UserProfile
  tournaments: [Tournament!]!
  leaderboard(type: String!, region: String): [LeaderboardEntry!]!
}

type Mutation {
  reportIntegrityEvent(input: IntegrityEventInput!): IntegrityResponse!
  createArenaRoom(config: ArenaConfigInput!): ArenaRoom!
}

type UserProfile {
  uid: ID!
  fullName: String!
  email: String!
  points: Int!
  streak: Int!
  educationLevel: String
}

type Tournament {
  id: ID!
  title: String!
  status: String!
}

type LeaderboardEntry {
  userId: ID!
  userName: String!
  rank: Int!
  points: Int!
  countryId: String!
}

input IntegrityEventInput {
  eventType: String!
  sessionId: String!
  details: String
}

type IntegrityResponse {
  status: String!
  action: String
}

type ArenaRoom {
  roomId: ID!
  status: String!
}

input ArenaConfigInput {
  subjectId: String!
  questionCount: Int!
}
